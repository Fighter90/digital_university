# deploy/Dockerfile.tools — разовые задачи БД (migrate deploy + seed).
# Запуск: docker compose --profile tools run --rm tools sh -c 'migrate+seed'
FROM node:22-slim
ENV PNPM_HOME=/pnpm \
    PATH="/pnpm:$PATH" \
    DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
COPY prisma/schema.prisma prisma/schema.prisma
RUN pnpm install --frozen-lockfile
COPY . .
# generate строго ПОСЛЕ COPY . .: rsync приносит gitignored src/generated
# (снапшот клиента локальной машины) и затирает сгенерённое — иначе tools
# работает по протухшему клиенту (seed: Unknown argument, напр. teacherEmail).
RUN pnpm exec prisma generate
CMD ["sleep", "infinity"]
