# Цифровой деканат — шаблон переменных окружения (DIG-7).
# Скопируйте и заполните: `cp .env.example .env` (локально) или `.env.production`
# (на сервере). В git попадает только этот шаблон; реальные значения — только
# в .env / .env.production и в секретах хостинга.
#
# ВАЖНО: секреты НИКОГДА не называйте с префиксом NEXT_PUBLIC_ — Next.js
# встраивает такие переменные в клиентский бандл, и они становятся видны
# в браузере. Все секреты ниже — серверные.

# ── Приложение ────────────────────────────────────────────────────────────
# Публичный адрес сайта (без слэша в конце)
APP_URL=http://localhost:3000
# Порт приложения на хосте (compose пробрасывает 127.0.0.1:APP_PORT → 3000)
APP_PORT=3000

# ── Caddy: reverse proxy, автоматический HTTPS ────────────────────────────
# Адрес основного сайта: локально `:80` (без TLS), в проде `ostrovok.store`
# (Caddy сам получит и продлит сертификат Let's Encrypt).
SITE_ADDRESS=:80
# www-домен для редиректа на основной. НЕ задавайте пустым — только
# закомментируйте локально и раскомментируйте в проде (.env.production):
# SITE_ADDRESS_WWW=www.ostrovok.store
# Порты Caddy на хосте
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Почта для уведомлений Let's Encrypt (опционально, прод)
ACME_EMAIL=

# ── PostgreSQL 16 (сервис db в docker-compose) ────────────────────────────
POSTGRES_DB=university
POSTGRES_USER=university
# Придумайте сильный пароль (openssl rand -base64 24)
POSTGRES_PASSWORD=change-me-strong-password
# Порт БД на хосте: публикуется только на 127.0.0.1 (наружу БД не торчит)
POSTGRES_PORT=5432
# Строка подключения Prisma. Внутри compose хост — `db`; при разработке без
# Docker (pnpm dev + своя БД) замените db:5432 на localhost:5432.
DATABASE_URL=postgresql://university:change-me-strong-password@db:5432/university?schema=public

# ── Сессии ────────────────────────────────────────────────────────────────
# Секрет подписи httpOnly cookie-сессий. Сгенерировать: openssl rand -base64 32
SESSION_SECRET=change-me-openssl-rand-base64-32

# ── AI-ассистент (ключ только на сервере, в браузер не попадает) ──────────
# Провайдер LLM: openai | openrouter | custom
LLM_PROVIDER=
# Базовый URL API провайдера (обязателен для custom/openrouter)
LLM_BASE_URL=
# API-ключ провайдера — только сервер, никогда NEXT_PUBLIC_
LLM_API_KEY=

# ── Подписанные ссылки на календари (.ics) ────────────────────────────────
# Секрет токена подписки: openssl rand -base64 32
ICS_TOKEN_SECRET=

# ── SMTP (письма о заявках и уведомлениях) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ostrovok.store
