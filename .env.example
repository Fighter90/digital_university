# Скопируйте в .env и заполните. Никогда не коммитьте настоящий .env.

# База данных (docker compose поднимет postgres с этими же значениями)
DATABASE_URL="postgresql://dig:change_me@localhost:5432/digital_university"

# Аутентификация (DIG-11): подпись role-hint cookie для middleware.
# Сгенерируйте: openssl rand -base64 32
AUTH_SECRET="generate: openssl rand -base64 32"

# Приложение (docker-compose)
POSTGRES_USER="dig"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="digital_university"

# --- НЕ КОММИТИТЬ ЗНАЧЕНИЯ НИЖЕ: это только имена для окружения рабочей машины ---
# LINEAR_DIGITAL_UNIVERSITY_API_KEY=   # Linear (рой)
# TIMEWEB_API_KEY=                     # DNS/домен ostrovok.store
# FIGMA_TOKEN=                         # чтение макетов через Figma REST API (опционально)
